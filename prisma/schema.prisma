// Prisma Schema for Hyva Transport MTMS
// Prisma 7: DB URLs go in prisma.config.ts, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN    // Platform Owner
  ORG_ADMIN      // Transporter Admin
  FIELD_MANAGER  // Site Supervisor
  OWNER          // Vehicle Owner (read-only access to own data)
}

enum ExpenseType {
  FUEL
  DRIVER_ADVANCE
  OWNER_ADVANCE
  MAINTENANCE
  TOLL
  CASH_PAYMENT
}

enum CompanyExpenseType {
  SALARY
  RENT
  INSURANCE
  EMI
  OFFICE
  PARTNER_PAYOUT
  OTHER
}

enum CashFlowDirection {
  CASH_IN
  CASH_OUT
}

enum TransactionType {
  PARTY_PAYMENT    // Money received from client/party
  OWNER_PAYMENT    // Money paid to vehicle owner
  ADVANCE_GIVEN    // Advance given to owner
  REFUND           // Any refund
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum BillStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model CashFlow {
  id            String            @id @default(cuid())
  date          DateTime          @default(now())
  direction     CashFlowDirection
  amount        Float
  category      String            // e.g. "Party Payment", "Loan", "Investment", "Office Rent", "EMI"
  description   String?
  transporterId String
  transporter   Transporter       @relation(fields: [transporterId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([transporterId])
  @@index([direction])
  @@index([date])
}

model BusinessPartner {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  equityPct       Float    @default(0)   // Profit share percentage (e.g. 30 = 30%)
  investedAmount  Float    @default(0)   // Total capital invested
  paidOutAmount   Float    @default(0)   // Total profit paid out to this partner
  transporterId   String
  transporter     Transporter @relation(fields: [transporterId], references: [id])
  createdAt       DateTime @default(now())
}

model CompanyExpense {
  id            String             @id @default(cuid())
  date          DateTime           @default(now())
  amount        Float
  type          CompanyExpenseType
  description   String?
  transporterId String
  transporter   Transporter        @relation(fields: [transporterId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([transporterId])
  @@index([date])
  @@index([type])
}

model Transporter {
  id           String    @id @default(cuid())
  name         String
  registration String?   // GST/Business ID
  users            User[]
  projects         Project[]
  owners           Owner[]
  partners         BusinessPartner[]
  companyExpenses  CompanyExpense[]
  cashFlows        CashFlow[]
  transactions     Transaction[]
  dailyLumpsums    DailyLumpsum[]
  partyBills       PartyBill[]
  createdAt        DateTime  @default(now())
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  password           String
  role               Role         @default(ORG_ADMIN)
  mustChangePassword Boolean      @default(false)
  transporterId      String?
  transporter        Transporter? @relation(fields: [transporterId], references: [id])
  owner              Owner?
}

model Project {
  id            String         @id @default(cuid())
  projectName   String
  location      String
  partyRate     Float          @default(0) // Rate we get from client
  ownerRate     Float          @default(0) // Rate we pay the owner
  transporterId String
  transporter   Transporter    @relation(fields: [transporterId], references: [id])
  trips         Trip[]
  vehicles      Vehicle[]
  expenses      Expense[]
  advances      OwnerAdvance[]
  ratePeriods   RatePeriod[]
  transactions  Transaction[]
  partyBills    PartyBill[]

  @@index([transporterId])
}

model Owner {
  id                String          @id @default(cuid())
  ownerName         String
  phone             String
  defaultPassword   String?
  ownerRateOverride Float?          // If set, overrides the project ownerRate for all their vehicles
  transporterId     String
  transporter       Transporter     @relation(fields: [transporterId], references: [id])
  userId            String?         @unique
  user              User?           @relation(fields: [userId], references: [id])
  vehicles          Vehicle[]
  settlements       Settlement[]
  advances          OwnerAdvance[]
  transactions      Transaction[]
}

model Vehicle {
  id             String    @id @default(cuid())
  plateNo        String    @unique
  ownerId        String
  owner          Owner     @relation(fields: [ownerId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  ownerRateOverride Float? // If set, overrides the project ownerRate for this vehicle
  trips          Trip[]
  expenses       Expense[]

  @@index([ownerId])
  @@index([projectId])
}

model Trip {
  id                 String   @id @default(cuid())
  date               DateTime @default(now())
  invoiceNo          String?  // External Trip ID / Invoice Number
  lrNo               String?  // Lorry Receipt Number / Yellow Sl No
  vehicleId          String
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id])
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  weight             Float    // MT (Metric Tons)
  ownerRate          Float    @default(0) // Revenue: Rate charged to the project/client
  partyRate          Float    @default(0) // Cost: Default rate to pay vehicle owners
  ownerFreightAmount Float    @default(0) // weight * ownerRate
  partyFreightAmount Float    @default(0) // weight * partyRate

  @@index([projectId])
  @@index([vehicleId])
  @@index([date])
}

model Expense {
  id        String      @id @default(cuid())
  date      DateTime    @default(now())
  vehicleId String
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id])
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id])
  amount    Float
  type      ExpenseType
  remarks   String?

  @@index([vehicleId])
  @@index([projectId])
  @@index([date])
  @@index([type])
}

enum SettlementStatus {
  PENDING
  SETTLED
}

model Settlement {
  id            String           @id @default(cuid())
  ownerId       String
  owner         Owner            @relation(fields: [ownerId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  totalRevenue  Float
  totalFuel     Float            @default(0)
  totalAdvances Float            @default(0)
  totalMaint    Float            @default(0)
  totalTolls    Float            @default(0)
  totalOther    Float            @default(0)
  finalPayout   Float
  paidAmount    Float?           // Actual amount paid/received when settled
  carryForward  Float            @default(0) // Balance carried forward to next settlement
  tripsCount    Int              @default(0)
  status        SettlementStatus @default(PENDING)
  settledAt     DateTime?
  createdAt     DateTime         @default(now())
  transactions  Transaction[]

  @@index([ownerId])
  @@index([status])
}

model OwnerAdvance {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  amount    Float
  remarks   String?

  @@index([ownerId])
  @@index([projectId])
  @@index([date])
}

// ========================
// Fortnightly Rate Periods
// ========================

model RatePeriod {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  periodStart   DateTime // e.g., 2026-07-01 or 2026-07-16
  periodEnd     DateTime // e.g., 2026-07-15 or 2026-07-31
  partyRate     Float    // Client billing rate for this period
  ownerRate     Float    // Owner payout rate for this period
  label         String?  // e.g., "Jul 1-15, 2026"
  createdAt     DateTime @default(now())

  @@unique([projectId, periodStart])
  @@index([projectId])
  @@index([periodStart])
}

// ========================
// Transaction Tracking
// ========================

model Transaction {
  id              String            @id @default(cuid())
  date            DateTime          @default(now())
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Float
  description     String?
  referenceNo     String?           // Cheque no, UTR, bank reference
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id])
  ownerId         String?
  owner           Owner?            @relation(fields: [ownerId], references: [id])
  settlementId    String?
  settlement      Settlement?       @relation(fields: [settlementId], references: [id])
  transporterId   String
  transporter     Transporter       @relation(fields: [transporterId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([transporterId])
  @@index([type])
  @@index([date])
  @@index([ownerId])
  @@index([projectId])
  @@index([status])
}

// ========================
// Daily Lumpsum Expense Log
// ========================

model DailyLumpsum {
  id            String      @id @default(cuid())
  date          DateTime
  category      String      // Maps to ExpenseType: FUEL, TOLL, MAINTENANCE, etc.
  amount        Float
  remarks       String?
  transporterId String
  transporter   Transporter @relation(fields: [transporterId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([transporterId, date, category])
  @@index([transporterId])
  @@index([date])
  @@index([category])
}

// ========================
// Party Bill Tracking (Receivables)
// ========================

model PartyBill {
  id              String      @id @default(cuid())
  billNo          String      // Your invoice/bill number
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  totalTrips      Int         @default(0)
  totalWeight     Float       @default(0)
  billAmount      Float       // Total amount billed to company
  incentive       Float       @default(0) // Extra incentive/bonus on bill
  receivedAmount  Float       @default(0) // Auto-calculated from payments
  status          BillStatus  @default(PENDING)
  submittedAt     DateTime?   // When bill was submitted to company
  dueDate         DateTime?   // Payment due date
  remarks         String?
  transporterId   String
  transporter     Transporter @relation(fields: [transporterId], references: [id])
  payments        BillPayment[]
  createdAt       DateTime    @default(now())

  @@index([transporterId])
  @@index([projectId])
  @@index([status])
  @@index([periodStart])
}

model BillPayment {
  id          String    @id @default(cuid())
  billId      String
  bill        PartyBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Float
  referenceNo String?   // UTR / Cheque / Bank reference
  remarks     String?
  createdAt   DateTime  @default(now())

  @@index([billId])
  @@index([date])
}
